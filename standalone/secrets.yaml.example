# Copy to conf/secrets.yaml (same directory as appdaemon.yaml) and fill in real
# values. Keep secrets.yaml out of git — add it to your own deployment repo's
# .gitignore. AppDaemon resolves `!secret <key>` in appdaemon.yaml / apps.yaml
# against this file automatically; no extra config needed.

hass_token: REPLACE_WITH_YOUR_HA_LONG_LIVED_ACCESS_TOKEN

# Only needed if you enabled the MQTT plugin in appdaemon.yaml.
mqtt_password: REPLACE_WITH_YOUR_MQTT_PASSWORD
